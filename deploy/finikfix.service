# /etc/systemd/system/finikfix.service  (ставится скриптом deploy/bootstrap-vps.sh)
[Unit]
Description=FinikFix site (Node.js)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=finikfix
Group=finikfix
# current — симлинк на активный релиз, его переключает deploy/remote-deploy.sh
WorkingDirectory=/opt/finikfix/current
EnvironmentFile=/opt/finikfix/shared/.env
ExecStart=/usr/bin/node server.mjs
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
SyslogIdentifier=finikfix

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
ReadWritePaths=/opt/finikfix/shared/data
MemoryMax=512M

[Install]
WantedBy=multi-user.target
