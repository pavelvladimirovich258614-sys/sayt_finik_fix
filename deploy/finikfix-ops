#!/usr/bin/env bash
# Административный помощник FinikFix. Устанавливается ОДИН РАЗ от root (deploy/install-ops-helper.sh) в /usr/local/sbin/finikfix-ops.
# Пользователь deploy (GitHub Actions) может вызывать ТОЛЬКО его через sudo; каждая подкоманда ниже — фиксированная операция,
# произвольных команд и произвольных путей нет. Секреты не печатаются.
set -euo pipefail
BASE=/opt/finikfix; ENVF=$BASE/shared/.env; DATA=$BASE/shared/data
NODE=/usr/bin/node
[ "$(id -u)" -eq 0 ] || { echo "нужен root (через sudo)" >&2; exit 1; }
exec 9>"$BASE/.ops.lock"; flock -n 9 || { echo "другая операция выполняется" >&2; exit 1; }
CUR="$BASE/current"
as_app() { runuser -u finikfix -- "$@"; }
node_app() { (cd "$CUR" && as_app "$NODE" --env-file="$ENVF" --no-warnings "$@"); }
cmd="${1:-}"; shift || true

env_set() { # KEY VALUE — только значения из белого списка, перед правкой копия .env
  local k="$1" v="$2" tmp; tmp="$(mktemp)"
  cp -p "$ENVF" "$BASE/backups/env-$(date +%Y%m%d-%H%M%S).bak"; chmod 600 "$BASE"/backups/env-*.bak
  grep -v "^${k}=" "$ENVF" > "$tmp" || true
  printf '%s=%s\n' "$k" "$v" >> "$tmp"
  cat "$tmp" > "$ENVF"; rm -f "$tmp"; chown root:finikfix "$ENVF"; chmod 0640 "$ENVF"
}
env_has() { grep -q "^$1=." "$ENVF"; }

case "$cmd" in
  status)
    echo "release: $(readlink -f "$CUR" || echo none)  sha: $(cat "$CUR/.release-sha" 2>/dev/null || echo ?)"
    echo "service: $(systemctl is-active finikfix)"
    for k in DATA_DIR ADMIN_ENABLED REVIEWS_FORM LEADS_ENABLED TG_BOT_TOKEN TG_CHAT_ID IP_SALT; do env_has "$k" && echo "env $k: задан" || echo "env $k: НЕ задан"; done
    echo "nginx блок /api/lead: $(grep -rl 'location = /api/lead' /etc/nginx/sites-enabled/ 2>/dev/null | head -1 || true)"
    ls -la "$DATA" | head -20; ls "$DATA/uploads" 2>/dev/null | wc -l | sed 's/^/файлов в uploads: /'
    ls -1t "$DATA/backups" 2>/dev/null | head -5 | sed 's/^/копия: /' ;;
  backup)
    install -d -m 0700 -o finikfix -g finikfix "$DATA/backups"
    node_app -e '
      const {DatabaseSync}=require("node:sqlite");const p=process.env.DATA_DIR+"/portfolio.db";
      const fs=require("fs");if(!fs.existsSync(p)){console.log("БД ещё нет, копировать нечего");process.exit(0)}
      const out=process.env.DATA_DIR+"/backups/manual-"+new Date().toISOString().replace(/[:.]/g,"-")+".db";
      new DatabaseSync(p).exec("VACUUM INTO \x27"+out+"\x27");
      const c=new DatabaseSync(out);console.log("копия:",out,"works:",c.prepare("select count(*) n from works").get().n)' ;;
  import-portfolio) [ "${1:-}" = "commit" ] && node_app scripts/import-portfolio.mjs --commit || node_app scripts/import-portfolio.mjs ;;
  import-reviews)   [ "${1:-}" = "commit" ] && node_app scripts/import-reviews.mjs --commit   || node_app scripts/import-reviews.mjs ;;
  set-secret) # значение читается из stdin, не печатается
    [ "${1:-}" = "TG_BOT_TOKEN" ] || { echo "разрешён только TG_BOT_TOKEN" >&2; exit 2; }
    IFS= read -r v || true; v="${v%$'\r'}"
    [[ "$v" =~ ^[0-9]{6,12}:[A-Za-z0-9_-]{30,60}$ ]] || { echo "значение не похоже на токен Telegram-бота" >&2; exit 2; }
    env_set TG_BOT_TOKEN "$v"; echo "TG_BOT_TOKEN записан (значение не выводится)" ;;
  set-env)
    k="${1:-}"; v="${2:-}"
    case "$k" in
      TG_CHAT_ID) [[ "$v" =~ ^-?[0-9]+(,-?[0-9]+){0,4}$ ]] || { echo "TG_CHAT_ID: числа через запятую" >&2; exit 2; } ;;
      REVIEWS_FORM|LEADS_ENABLED|ADMIN_ENABLED) [[ "$v" =~ ^[01]$ ]] || { echo "$k: 0 или 1" >&2; exit 2; } ;;
      *) echo "ключ не разрешён" >&2; exit 2 ;;
    esac
    env_set "$k" "$v"; echo "$k обновлён" ;;
  gen-salt) env_has IP_SALT && echo "IP_SALT уже задан" || { env_set IP_SALT "$(head -c 24 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | head -c 32)"; echo "IP_SALT создан"; } ;;
  tg-check) node_app scripts/telegram-check.mjs ;;
  tg-test)  node_app scripts/telegram-check.mjs --send ;;
  nginx-lead)
    sub="${1:-status}"
    files="$(grep -rl 'location = /api/lead' /etc/nginx/sites-enabled/ /etc/nginx/conf.d/ 2>/dev/null || true)"
    if [ "$sub" = "status" ]; then [ -n "$files" ] && echo "блок 503 /api/lead ЕСТЬ в: $files" || echo "блока 503 /api/lead нет"; exit 0; fi
    [ "$sub" = "open" ] || { echo "nginx-lead status|open" >&2; exit 2; }
    [ -n "$files" ] || { echo "блока уже нет"; exit 0; }
    ts="$(date +%Y%m%d-%H%M%S)"; install -d -m 0700 "$BASE/backups"
    for f in $files; do
      real="$(readlink -f "$f")"; cp -p "$real" "$BASE/backups/nginx-$(basename "$real")-$ts"
      python3 - "$real" <<'PY'
import re,sys
p=sys.argv[1]; s=open(p).read()
n=re.sub(r'\n[ \t]*location = /api/lead \{[^{}]*\}\n', '\n', s)
if n==s: sys.exit("блок не найден по шаблону")
open(p,'w').write(n)
PY
    done
    if nginx -t 2>/dev/null; then systemctl reload nginx; echo "блок удалён, nginx перезагружен"; else
      for f in $files; do real="$(readlink -f "$f")"; cp -p "$BASE/backups/nginx-$(basename "$real")-$ts" "$real"; done
      nginx -t || true; echo "nginx -t не прошёл, конфиг восстановлен" >&2; exit 1; fi ;;
  verify-data)
    node_app -e '
      const {DatabaseSync}=require("node:sqlite");const fs=require("fs");const d=process.env.DATA_DIR;
      const db=new DatabaseSync(d+"/portfolio.db");const q=(s)=>db.prepare(s).get();
      const works=q("select count(*) n from works where published=1").n, photos=q("select count(*) n from photos").n;
      const miss=db.prepare("select file from photos").all().filter(r=>!fs.existsSync(d+"/uploads/"+r.file)).length;
      console.log("works опубликовано:",works,"photos:",photos,"файлов не хватает:",miss);
      console.log("reviews: всего",q("select count(*) n from reviews").n,"опубликовано avito",q("select count(*) n from reviews where source=\x27avito\x27 and status=\x27approved\x27").n,"site pending",q("select count(*) n from reviews where source=\x27site\x27 and status=\x27pending\x27").n,"site approved",q("select count(*) n from reviews where source=\x27site\x27 and status=\x27approved\x27").n);
      console.log("leads:",q("select count(*) n from leads").n)' ;;
  *) echo "неизвестная операция: $cmd" >&2; exit 2 ;;
esac
