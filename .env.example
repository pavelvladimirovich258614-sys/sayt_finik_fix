# Скопируйте в .env и заполните. Файл .env в git не попадает.
PORT=3000
HOST=127.0.0.1
TRUST_PROXY=1                 # 1, если перед Node стоит nginx
SITE_URL=                     # [Уточнить: домен], например https://finikfix.ru (для canonical и sitemap)
METRIKA_ID=                   # [Уточнить: номер счётчика Яндекс.Метрики]
SITE_INN=                     # [Уточнить: ИНН самозанятого]
ADMIN_ENABLED=                # 1 включает /admin (только за HTTPS). По умолчанию выключено
SITE_MAX=                     # ссылка на MAX (когда будет настроен); пока пусто — кнопка не выводится
UPLOAD_DIR=                   # каталог загруженных фото портфолио; по умолчанию DATA_DIR/uploads


# --- Заявки и отзывы (по умолчанию ВЫКЛЮЧЕНО; секреты только здесь или в /opt/finikfix/shared/.env, не в git) ---
LEADS_ENABLED=                # 1 включает POST /api/lead (нужен хотя бы один настроенный канал; на production ещё и убрать 503 в nginx)
TG_BOT_TOKEN=                 # токен НОВОГО бота @uved_nikita_bot после /revoke в @BotFather; старый токен скомпрометирован
TG_CHAT_ID=                   # id получателей через запятую (например: 111,222); на каждого своя запись доставки
REVIEWS_FORM=                 # 1 включает приём отзывов с сайта (на модерацию)
IP_SALT=                      # любая случайная строка: соль для хеша IP (антиспам)
