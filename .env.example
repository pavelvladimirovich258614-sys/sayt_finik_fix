# Скопируйте в .env и заполните. Файл .env в git не попадает.
PORT=3000
HOST=127.0.0.1
TRUST_PROXY=1                 # 1, если перед Node стоит nginx
SITE_URL=                     # [Уточнить: домен], например https://finikfix.ru (для canonical и sitemap)
METRIKA_ID=                   # [Уточнить: номер счётчика Яндекс.Метрики]
SITE_INN=                     # [Уточнить: ИНН самозанятого]
TG_BOT_TOKEN=                 # [Уточнить: токен бота от @BotFather]
TG_CHAT_ID=                   # [Уточнить: chat id мастера, куда слать заявки]
